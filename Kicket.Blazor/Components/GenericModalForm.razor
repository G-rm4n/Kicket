@* Ventana modal genérica con un formulario: recibe el título, el objeto a editar y el contenido del formulario. *@
@typeparam TOjb

<div class="modal fade show d-block" tabindex="-1" style="background-color:rgba(0,0,0,0.5);">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Titulo</h5>
                <button type="button" class="btn-close" @onclick="Cerrar"></button>
            </div>
            @* EditForm valida con las Data Annotations del objeto y, si es válido, llama a Enviar. *@
            <EditForm Model="Obj" OnValidSubmit="Enviar">
                <DataAnnotationsValidator></DataAnnotationsValidator>
            <div class="modal-body">
                @* Dibuja los campos que le pasa la página que usa el modal. *@
                @* Error devuelto por la API (por ejemplo, DNI repetido): se muestra dentro del modal para que se vea. *@
                @if (!string.IsNullOrEmpty(Error))
                {
                    <div class="alert alert-danger py-2 small">@Error</div>
                }
                @if(CuerpoForm is not null && this.Obj is not null){
                    @CuerpoForm!(Obj!) 
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="Cerrar">Cancelar</button>
                <button type="submit" class="btn bg-primary">Confirmar</button>
            </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    // Título del modal.
    [Parameter]
    public string Titulo { get; set; } = "Fromulario";
    // Contenido del formulario (los campos), recibe el objeto a editar.
    [Parameter]
    public RenderFragment<TOjb>? CuerpoForm{ get; set; }
    // Objeto que se está editando.
    [Parameter]
    public TOjb Obj { get; set; } = default!;
    // Mensaje de error a mostrar dentro del modal (null = sin error).
    [Parameter]
    public string? Error { get; set; }
    // Evento que se dispara al confirmar el formulario.
    [Parameter]
    public EventCallback<TOjb> Onsubmit { get; set; }
    // Evento que se dispara al cerrar el modal.
    [Parameter]
    public EventCallback OnCerrar{ get; set; }

    // Avisa a la página padre que se cerró el modal.
    public async Task Cerrar()
    {
        await OnCerrar.InvokeAsync();
    }

    // Avisa a la página padre que se confirmó, pasándole el objeto.
    public async Task Enviar()
    {
        await Onsubmit.InvokeAsync(this.Obj);
    }
}
