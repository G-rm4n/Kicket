@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization


<nav class="navbar bg-light navbar-light container-fluid shadow-sm m-1">
    <div class="d-flex flex-row gap-3 align-items-center justify-content-around">
        <div>
            <NavLink href="" >
                <img style="height:40px ;width:auto" src="/assets/logo.png"/>
            </NavLink>
        </div>

        <NavLink href="" class="text-decoration-none text-reset">
            <h3 class="text-center mb-0 fw-bolder">
                Kicket
            </h3>
        </NavLink>

    </div>

    <div class="container-button d-flex flex-row gap-3 align-items-center justify-content-around">
        <AuthorizeView>
            <Authorizing>
                <div class="spinner-border spinner-border-sm text-secondary" role="status">
                    <span>Cargando...</span>
                </div>
            </Authorizing>
            <NotAuthorized>
                <NavLink href="/auth/registro">
                    <button class="btn bg-primary text-white-100">Registrarse</button>
                </NavLink>
                <NavLink HREF="/auth/login">
                    <button class="btn bg-secondary text-white">Ingresar</button>
                </NavLink>
            </NotAuthorized>
            <Authorized>
                <button class="btn bg-primary text-white-100">Mi perfil</button>
            </Authorized>
        </AuthorizeView>
    </div>
</nav>

<main class="container mt-4">
    @Body
</main>
