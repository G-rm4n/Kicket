@using Microsoft.AspNetCore.Components.Authorization
@using Kicket.Blazor.Core.state
@inject NavigationManager Nav
@inject KicketAuthStateProvider prov
@implements IDisposable

<nav class="navbar bg-light navbar-light container-fluid shadow-sm">
    <div class="d-flex flex-row gap-3 align-items-center justify-content-around">
        <div>
            <NavLink href="" >
                <img style="height:40px ;width:auto" src="/assets/logo.png"/>
            </NavLink>
        </div>

        <NavLink href="" class="text-decoration-none text-reset">
            <h3 class="text-center mb-0 fw-bolder">
                Kicket
            </h3>
        </NavLink>

    </div>

    @if (!EsRutaAuth)
    {
        <div class="container-button d-flex flex-row gap-3 align-items-center justify-content-around">
            <AuthorizeView>
            <Authorizing>
                <div class="spinner-border spinner-border-sm text-secondary" role="status">
                    <span>Cargando...</span>
                </div>
            </Authorizing>
            <NotAuthorized>
                <NavLink href="/auth/registro">
                    <button class="btn bg-primary text-white-100">Registrarse</button>
                </NavLink>
                <NavLink HREF="/auth/login">
                    <button class="btn bg-secondary text-white">Iniciar Sesion</button>
                </NavLink>
            </NotAuthorized>
            <Authorized>
                    @if (!EstoyEnPerfil)
                    {
                        <NavLink href="@_urlIngreso">
                            <button class="btn bg-primary text-white-100">Ingresar</button>
                        </NavLink>
                    }
            </Authorized>
        </AuthorizeView>
    </div>
    }
</nav>

@code {
    private bool EsRutaAuth => Nav.Uri.Contains("/auth/login", StringComparison.OrdinalIgnoreCase) ||
                                   Nav.Uri.Contains("/auth/registro", StringComparison.OrdinalIgnoreCase);

    private bool EstoyEnPerfil => Nav.Uri.Contains("/perfil", StringComparison.OrdinalIgnoreCase) ||
                                  Nav.Uri.Contains("/Admin", StringComparison.OrdinalIgnoreCase);

    private string? _urlIngreso;

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        _urlIngreso = await UrlIngreso();
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }

    public void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = SetUrlIngresoAsync();
        StateHasChanged();
    }

    private async Task SetUrlIngresoAsync()
    {
        _urlIngreso = await UrlIngreso();
        StateHasChanged();
    }

    private async Task<string> UrlIngreso()
    {
        if (await this.EsAdminAsync())
        {
            return "/Admin/clubs";
        }
        else
        {
            return "/Building";
        }
    }

    private async Task<bool> EsAdminAsync()
    {
        var authState = await prov.GetAuthenticationStateAsync();
        var user = authState.User;
        return user.Identity != null && user.Identity.IsAuthenticated && user.IsInRole("Admin");
    }
}
