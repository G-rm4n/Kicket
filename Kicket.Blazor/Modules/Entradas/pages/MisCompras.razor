@* Página "Mis Entradas" (rutas /mis-entradas y /mis-compras): las entradas del usuario agrupadas POR PARTIDO.
   Cada partido aparece una sola vez aunque venga de varias compras; el detalle se abre con "Ver entradas".
   La agrupación, los filtros, el orden y la paginación (por partido) los resuelve la API.
   A pedido del profesor NO se muestran fila ni asiento: la API ni siquiera los manda en este listado. *@
@page "/mis-entradas"
@page "/mis-compras"
@using Kicket.ApiClient.Abstracciones
@using Kicket.Blazor.Core.HTTP
@using Kicket.Blazor.Core.state
@using Kicket.Contracts.Common
@using Kicket.Contracts.Compras
@inherits PaginaApi
@inject ICompraApiClient compraApi
@inject ISesionUsuario sesion
@inject KicketAuthStateProvider authStateProvider
@inject NavigationManager Nav

<div class="container py-4 py-md-5" style="min-height: 80vh;">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="fw-bold text-dark mb-1">Mis Entradas</h1>
            <p class="text-secondary mb-0">Tus partidos, del más próximo al más lejano. Abrí cada uno para ver sus entradas y códigos QR.</p>
        </div>
        <a href="/eventos" class="btn btn-success fw-semibold rounded-pill px-4">Comprar nuevas entradas</a>
    </div>

    <PanelFiltros Cargando="Procesando" OnBuscar="BuscarAsync" OnLimpiar="LimpiarFiltrosAsync">
        <div class="col-12 col-lg-3">
            <label class="form-label small mb-1" for="f-buscar">Buscar partido</label>
            <input id="f-buscar" class="form-control form-control-sm" placeholder="Club, partido o estadio" @bind="filtro.Busqueda" />
        </div>
        <div class="col-6 col-lg-2">
            <label class="form-label small mb-1" for="f-desde">Partido desde</label>
            <input id="f-desde" type="date" class="form-control form-control-sm" @bind="filtro.Desde" />
        </div>
        <div class="col-6 col-lg-2">
            <label class="form-label small mb-1" for="f-hasta">Partido hasta</label>
            <input id="f-hasta" type="date" class="form-control form-control-sm" @bind="filtro.Hasta" />
        </div>
        <div class="col-6 col-lg-2">
            <label class="form-label small mb-1" for="f-estado">Estado</label>
            <select id="f-estado" class="form-select form-select-sm" @bind="filtro.Estado">
                <option value="@MisEntradasFiltro.EstadoTodos">Todos</option>
                <option value="@MisEntradasFiltro.EstadoProximos">Próximos</option>
                <option value="@MisEntradasFiltro.EstadoPasados">Finalizados</option>
                <option value="@MisEntradasFiltro.EstadoCancelados">Cancelados</option>
            </select>
        </div>
        <div class="col-6 col-lg-2">
            <label class="form-label small mb-1" for="f-orden">Ordenar por</label>
            <select id="f-orden" class="form-select form-select-sm" @bind="filtro.OrdenarPor">
                <option value="@MisEntradasFiltro.OrdenPartidoProximo">Partido más próximo</option>
                <option value="@MisEntradasFiltro.OrdenPartidoLejano">Partido más lejano</option>
                <option value="@MisEntradasFiltro.OrdenCompraReciente">Compra más reciente</option>
                <option value="@MisEntradasFiltro.OrdenCompraAntigua">Compra más antigua</option>
            </select>
        </div>
    </PanelFiltros>

    @* Muestra el error, si hay. *@
    @if (!string.IsNullOrEmpty(MensajeError))
    {
        <div class="alert alert-danger shadow-sm">@MensajeError</div>
    }

    @if (Procesando && resultado is null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-success" role="status"></div>
            <p class="mt-2 text-secondary">Cargando tus entradas...</p>
        </div>
    }
    else if (resultado is not null && resultado.TotalRegistros == 0)
    {
        <div class="card border-0 shadow-sm text-center p-5 bg-light">
            @if (HayFiltros)
            {
                <h4 class="fw-bold text-secondary mb-2">No hay partidos que coincidan con los filtros</h4>
                <p class="text-muted mb-3">Probá con otras fechas o limpiá los filtros.</p>
                <div><button class="btn btn-outline-secondary rounded-pill px-4" @onclick="LimpiarFiltrosAsync">Limpiar filtros</button></div>
            }
            else
            {
                <h4 class="fw-bold text-secondary mb-2">Todavía no tenés entradas</h4>
                <p class="text-muted mb-4">Explorá la cartelera de próximos partidos y comprá tus entradas online.</p>
                <div><a href="/eventos" class="btn btn-success rounded-pill px-4 py-2 fw-bold">Ver eventos disponibles</a></div>
            }
        </div>
    }
    else if (resultado is not null)
    {
        <div class="d-flex flex-column gap-3 @(Procesando ? "opacity-50" : "")">
            @foreach (var partido in resultado.Items)
            {
                bool abierto = _abiertos.Contains(partido.EventoId);
                string idDetalle = $"detalle-{partido.EventoId}";

                <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="card-body p-3 p-md-4">
                        <div class="d-flex flex-column flex-md-row align-items-md-center gap-3">
                            @* Fecha en bloque compacto *@
                            <div class="text-center rounded-3 px-3 py-2 flex-shrink-0 @ClaseFecha(partido)" style="min-width: 86px;">
                                <div class="fw-bold fs-4 lh-1">@partido.Fecha.ToString("dd")</div>
                                <div class="small text-uppercase">@partido.Fecha.ToString("MMM yyyy", _ar)</div>
                                <div class="small fw-semibold">@partido.Fecha.ToString("HH:mm") hs</div>
                            </div>

                            <div class="flex-grow-1">
                                <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                    <h2 class="h5 fw-bold mb-0">@partido.ClubLocal <span class="text-secondary fw-normal">vs</span> @partido.ClubVisitante</h2>
                                    <span class="badge rounded-pill @ClaseEstado(partido)">@partido.Estado</span>
                                </div>
                                <div class="small text-secondary">@partido.EventoNombre</div>
                                <div class="small text-secondary">🏟️ @partido.EstadioNombre (@partido.EstadioCiudad)</div>
                            </div>

                            <div class="d-flex flex-row flex-md-column align-items-center align-items-md-end gap-2 flex-shrink-0">
                                <span class="fw-semibold">@partido.CantidadEntradas @(partido.CantidadEntradas == 1 ? "entrada" : "entradas")</span>
                                <button type="button" class="btn btn-sm btn-outline-success fw-semibold rounded-pill px-3"
                                        aria-expanded="@(abierto ? "true" : "false")" aria-controls="@idDetalle"
                                        @onclick="() => Alternar(partido.EventoId)">
                                    @(abierto ? "Ocultar entradas ▲" : "Ver entradas ▼")
                                </button>
                            </div>
                        </div>

                        @if (abierto)
                        {
                            <div id="@idDetalle" class="mt-3 pt-3 border-top">
                                @if (!string.IsNullOrWhiteSpace(partido.Descripcion))
                                {
                                    <div class="alert alert-light border small py-2">ℹ️ @partido.Descripcion</div>
                                }
                                <div class="d-flex flex-wrap gap-3 small text-secondary mb-2">
                                    <span>@partido.CantidadCompras @(partido.CantidadCompras == 1 ? "compra" : "compras")</span>
                                    <span>Total pagado: <strong class="text-dark">$@partido.TotalPagado.ToString("N2", _ar)</strong></span>
                                    <span>Última compra: @partido.UltimaCompra.ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-sm align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Entrada</th>
                                                <th>Sector</th>
                                                <th class="d-none d-md-table-cell">Compra</th>
                                                <th class="d-none d-md-table-cell">Fecha de compra</th>
                                                <th>Estado</th>
                                                <th class="text-center">QR</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var entrada in partido.Entradas)
                                            {
                                                <tr>
                                                    <td class="fw-semibold">#@entrada.EntradaId</td>
                                                    <td>@entrada.SectorNombre</td>
                                                    <td class="d-none d-md-table-cell">#@entrada.CompraId</td>
                                                    <td class="d-none d-md-table-cell">@entrada.FechaCompra.ToString("dd/MM/yyyy HH:mm")</td>
                                                    <td><span class="badge bg-success-subtle text-success-emphasis">@(entrada.EstadoPago ?? "Aprobado")</span></td>
                                                    <td class="text-center">
                                                        <button type="button" class="btn btn-sm btn-outline-dark px-3" @onclick="() => AbrirQr(partido, entrada)">
                                                            Ver QR
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <Paginador Pagina="resultado.Pagina" TotalPaginas="resultado.TotalPaginas" TotalRegistros="resultado.TotalRegistros"
                   TamanoPagina="resultado.TamanoPagina" Cargando="Procesando"
                   OnCambioPagina="IrAPaginaAsync" OnCambioTamano="CambiarTamanoAsync" />
    }
</div>

@* Modal del ticket con QR. MostrarUbicacion=false: en esta pantalla no se muestran fila ni asiento. *@
<TicketQrModal @bind-Visible="_modalQrVisible"
               EntradaId="_entradaQr?.EntradaId ?? 0"
               EventoNombre="@(_partidoQr is null ? string.Empty : $"{_partidoQr.ClubLocal} vs {_partidoQr.ClubVisitante}")"
               FechaTexto="@(_partidoQr?.Fecha.ToString("dd/MM/yyyy HH:mm") ?? string.Empty)"
               EstadioNombre="@(_partidoQr is null ? string.Empty : $"{_partidoQr.EstadioNombre} ({_partidoQr.EstadioCiudad})")"
               SectorNombre="@(_entradaQr?.SectorNombre ?? string.Empty)"
               MostrarUbicacion="false"
               CodigoQr="@(_entradaQr?.CodigoQr ?? string.Empty)" />

@code {
    private static readonly System.Globalization.CultureInfo _ar = System.Globalization.CultureInfo.GetCultureInfo("es-AR");

    // Filtros (por defecto: todos los partidos, el más próximo primero) y la página que devolvió la API.
    private MisEntradasFiltro filtro = NuevoFiltro();
    private PagedResult<PartidoConEntradasDto>? resultado;
    // Partidos con el detalle desplegado.
    private readonly HashSet<int> _abiertos = new();

    // Estado del modal QR.
    private bool _modalQrVisible;
    private PartidoConEntradasDto? _partidoQr;
    private MiEntradaDto? _entradaQr;

    private static MisEntradasFiltro NuevoFiltro() => new()
    {
        Estado = MisEntradasFiltro.EstadoTodos,
        OrdenarPor = MisEntradasFiltro.OrdenPartidoProximo,
        TamanoPagina = 10
    };

    private bool HayFiltros => !string.IsNullOrWhiteSpace(filtro.Busqueda) || filtro.Desde.HasValue || filtro.Hasta.HasValue
                               || filtro.Estado != MisEntradasFiltro.EstadoTodos;

    // Al abrir la página: si no hay sesión manda al login; si hay, carga la primera página.
    protected override async Task OnInitializedAsync()
    {
        var authState = await authStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true || !sesion.EstaAutenticado || sesion.Usuario is null)
        {
            Nav.NavigateTo("/auth/login");
            return;
        }

        await CargarAsync();
    }

    // Pide a la API los partidos del usuario (el usuario sale del token, no se manda).
    private async Task CargarAsync()
    {
        await SecureExec(async () =>
        {
            resultado = await compraApi.GetMisEntradasAsync(filtro);
            filtro.Pagina = resultado.Pagina;
            // Si hay un solo partido en la página, se abre directamente.
            if (resultado.Items.Count == 1) _abiertos.Add(resultado.Items[0].EventoId);
        });
    }

    private async Task BuscarAsync()
    {
        filtro.Pagina = 1;
        await CargarAsync();
    }

    private async Task LimpiarFiltrosAsync()
    {
        filtro = NuevoFiltro();
        await CargarAsync();
    }

    private async Task IrAPaginaAsync(int pagina)
    {
        filtro.Pagina = pagina;
        await CargarAsync();
    }

    private async Task CambiarTamanoAsync(int tamano)
    {
        filtro.TamanoPagina = tamano;
        filtro.Pagina = 1;
        await CargarAsync();
    }

    // Abre o cierra el detalle de un partido.
    private void Alternar(int eventoId)
    {
        if (!_abiertos.Remove(eventoId)) _abiertos.Add(eventoId);
    }

    private void AbrirQr(PartidoConEntradasDto partido, MiEntradaDto entrada)
    {
        _partidoQr = partido;
        _entradaQr = entrada;
        _modalQrVisible = true;
    }

    // Colores según el estado derivado del partido.
    private static string ClaseEstado(PartidoConEntradasDto p) =>
        p.EstaCancelado ? "bg-danger" : p.EsPasado ? "bg-secondary" : "bg-success";

    private static string ClaseFecha(PartidoConEntradasDto p) =>
        p.EstaCancelado ? "bg-danger-subtle text-danger-emphasis"
        : p.EsPasado ? "bg-light text-secondary"
        : "bg-success-subtle text-success-emphasis";
}
