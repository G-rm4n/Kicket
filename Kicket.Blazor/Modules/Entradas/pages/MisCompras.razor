@page "/mis-compras"
@using Kicket.ApiClient.Abstracciones
@using Kicket.Blazor.Core.HTTP
@using Kicket.Blazor.Core.state
@using Kicket.Contracts.Compras
@using Kicket.Contracts.Eventos
@using Kicket.Contracts.Sectores
@inherits PaginaApi
@inject ICompraApiClient compraApi
@inject IEventoApiClient eventoApi
@inject ISectorApiClient sectorApi
@inject ISesionUsuario sesion
@inject KicketAuthStateProvider authStateProvider
@inject NavigationManager Nav

<div class="container py-5" style="min-height: 80vh;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold text-dark mb-1">Mis Compras y Entradas</h1>
            <p class="text-secondary mb-0">Consultá el historial de tus compras y las ubicaciones de tus entradas.</p>
        </div>
        <a href="/eventos" class="btn btn-success fw-semibold rounded-pill px-4">
            Comprar Nuevas Entradas
        </a>
    </div>

    @if (!string.IsNullOrEmpty(MensajeError))
    {
        <div class="alert alert-danger shadow-sm">
            @MensajeError
        </div>
    }

    @if (Procesando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-success" role="status"></div>
            <p class="mt-2 text-secondary">Cargando tus entradas...</p>
        </div>
    }
    else if (_misCompras.Count == 0)
    {
        <div class="card border-0 shadow-sm text-center p-5 bg-light">
            <h4 class="fw-bold text-secondary mb-2">Todavía no tenés compras registradas</h4>
            <p class="text-muted mb-4">Explorá la cartelera de eventos próximos y adquirí tus entradas online.</p>
            <div>
                <a href="/eventos" class="btn btn-success rounded-pill px-4 py-2 fw-bold">
                    Ver Eventos Disponibles
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-4">
            @foreach (var compra in _misCompras)
            {
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="card-header bg-dark text-white py-3 px-4 d-flex flex-wrap justify-content-between align-items-center">
                        <div>
                            <span class="fw-bold">Compra #@compra.CompraId</span>
                            <span class="text-secondary mx-2">|</span>
                            <span class="small text-light opacity-75">Fecha: @compra.FechaCompra.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <div class="fw-bold text-success fs-5">
                            Total: $@compra.MontoTotal.ToString("N2") (@compra.Cantidad entrada@(compra.Cantidad > 1 ? "s" : ""))
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Código Entrada</th>
                                        <th>Evento</th>
                                        <th>Fecha del Partido</th>
                                        <th>Sector</th>
                                        <th>Ubicación Asignada</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var ent in compra.Entradas)
                                    {
                                        <tr>
                                            <td class="fw-bold">#@ent.EntradaId</td>
                                            <td>@ObtenerNombreEvento(ent.EventoId)</td>
                                            <td>@ObtenerFechaEvento(ent.EventoId)</td>
                                            <td>@ObtenerNombreSector(ent.SectorId)</td>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(ent.FilaAsiento))
                                                {
                                                    <span class="badge bg-info text-dark px-3 py-2">@ent.FilaAsiento</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary px-3 py-2">Sin numeración (Popular)</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<CompraDto> _misCompras = new();
    private Dictionary<int, EventoDto> _eventosMap = new();
    private Dictionary<int, SectorDto> _sectoresMap = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await authStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true || !sesion.EstaAutenticado || sesion.Usuario is null)
        {
            Nav.NavigateTo("/auth/login");
            return;
        }

        await CargarComprasAsync();
    }

    private async Task CargarComprasAsync()
    {
        if (sesion.Usuario is null) return;

        await SecureExec(async () =>
        {
            var compras = await compraApi.GetByUsuarioIdAsync(sesion.Usuario.IdUsuario);
            var eventos = await eventoApi.GetAllAsync();
            var sectores = await sectorApi.GetAllAsync();

            _eventosMap = eventos.ToDictionary(e => e.IdEvento);
            _sectoresMap = sectores.ToDictionary(s => s.SectorId);
            _misCompras = compras.OrderByDescending(c => c.FechaCompra).ToList();
        });
    }

    private string ObtenerNombreEvento(int eventoId) =>
        _eventosMap.TryGetValue(eventoId, out var ev) ? ev.Nombre : $"Evento #{eventoId}";

    private string ObtenerFechaEvento(int eventoId) =>
        _eventosMap.TryGetValue(eventoId, out var ev) ? ev.Fecha.ToString("dd/MM/yyyy HH:mm") : "-";

    private string ObtenerNombreSector(int sectorId) =>
        _sectoresMap.TryGetValue(sectorId, out var sec) ? sec.Nombre : $"Sector #{sectorId}";
}
