@* Pantalla de administración de clubes (ruta /Admin/Clubs): listar con filtros y paginación, crear, editar y borrar. Solo Admin. *@
@page "/Admin/Clubs"
@using Kicket.Contracts.Clubes
@using Kicket.Contracts.Common
@using Kicket.ApiClient.Abstracciones
@inherits PaginaProtegida
@layout AdminLayout
@inject IClubApiClient clubClient

<div class="d-flex flex-column mb-3">
    <h1>Gestionar Clubes</h1>

    @* Filtros: se aplican en la API (no sobre la lista ya cargada) y se conservan al cambiar de página. *@
    <PanelFiltros Cargando="Procesando" OnBuscar="BuscarAsync" OnLimpiar="LimpiarFiltrosAsync">
        <div class="col-12 col-md-4">
            <label class="form-label small mb-1">Buscar</label>
            <input class="form-control form-control-sm" placeholder="Nombre, sigla o descripción" @bind="filtro.Busqueda" />
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label small mb-1">Ciudad</label>
            <input class="form-control form-control-sm" @bind="filtro.Ciudad" />
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label small mb-1">Ordenar por</label>
            <select class="form-select form-select-sm" @bind="Orden">
                <option value="nombre|false">Nombre (A-Z)</option>
                <option value="nombre|true">Nombre (Z-A)</option>
                <option value="ciudad|false">Ciudad</option>
                <option value="fundacion|false">Más antiguos primero</option>
                <option value="fundacion|true">Más nuevos primero</option>
            </select>
        </div>
    </PanelFiltros>

    <div class="p-1">
        @* Tabla de clubes; click en una fila la selecciona. *@
        <GenericTable TItem="ClubDto" DatosTabla="resultado?.Items ?? new List<ClubDto>()"
                      OnClick="SelectFila"
                      FilaSeleccionada="@(c=>c.ClubId==this.IdClub)">
            <Cabeceras>
                @foreach(var value in Cab)
                {
                    <th>@value</th>
                }
            </Cabeceras>
            <fila Context="Club">
                <td>@Club.ClubId</td>
                <td>@Club.Nombre</td>
                <td>@Club.Abreviatura</td>
                <td>@Club.Ciudad</td>
                <td>@Club.AnioFundacion</td>
                <td class="text-truncate" style="max-width: 260px">@Club.Descripcion</td>
            </fila>
        </GenericTable>

        @if (resultado is not null)
        {
            <Paginador Pagina="resultado.Pagina" TotalPaginas="resultado.TotalPaginas" TotalRegistros="resultado.TotalRegistros"
                       TamanoPagina="resultado.TamanoPagina" Cargando="Procesando"
                       OnCambioPagina="IrAPaginaAsync" OnCambioTamano="CambiarTamanoAsync" />
        }
    </div>

    @* Botones de acción: borrar y editar se habilitan solo con un club seleccionado. *@
    <div class="d-flex justify-content-end flex-row flex-wrap gap-3 w-100">
        <button class="btn btn-danger text-white" disabled="@(!IsClubSelected)" @onclick="EliminarClub">Borrar Club</button>
        <button class="btn bg-primary text-white" disabled="@(!IsClubSelected)" @onclick="AbrirModalEdicion">Editar Club</button>
        <button class="btn btn-green" @onclick="AbrirModalCreacion">Crear Club</button>
        <button class="btn bg-secondary text-white" @onclick="CargarClubesAsync">Refrescar</button>
    </div>

    @* Modal de edición: aparece con los datos del club seleccionado. *@
    @if (this.ShowModalEdicion && clubEditando is not null)
    {
        <GenericModalForm TOjb="ClubUpdateRequest" Obj="clubEditando" Titulo="Editar Club" Error="@MensajeError" OnCerrar="CerrarModalEdicion" Onsubmit="EnviarEditado">
            <CuerpoForm Context="club">
                @CamposClub(club)
            </CuerpoForm>
        </GenericModalForm>
    }

    @* Modal de creación de un club nuevo. *@
    @if (this.ShowModalCreacion && nuevoClub is not null)
    {
        <GenericModalForm TOjb="ClubRequest" Obj="nuevoClub" Titulo="Crear Club" Error="@MensajeError" OnCerrar="CerrarModalCreacion" Onsubmit="EnviarNuevoClub">
            <CuerpoForm Context="club">
                @CamposClub(club)
            </CuerpoForm>
        </GenericModalForm>
    }

    @* Muestra el error, si hay. *@
    @if (!string.IsNullOrEmpty(MensajeError) && !ShowModalCreacion && !ShowModalEdicion)
    {
        <div class="alert alert-danger mt-3">
            @MensajeError
        </div>
    }
</div>

@code {
    // Campos del formulario, compartidos por el alta y la edición (ClubUpdateRequest hereda de ClubRequest).
    private RenderFragment CamposClub(ClubRequest club) => __builder =>
    {
        <div class="mb-3">
            <label class="form-label">Nombre</label>
            <InputText class="form-control" @bind-Value="club.Nombre" />
            <ValidationMessage For="@(() => club.Nombre)"></ValidationMessage>
        </div>
        <div class="row">
            <div class="col-6 mb-3">
                <label class="form-label">Abreviatura</label>
                <InputText class="form-control" @bind-Value="club.Abreviatura" />
                <ValidationMessage For="@(() => club.Abreviatura)"></ValidationMessage>
            </div>
            <div class="col-6 mb-3">
                <label class="form-label">Año de fundación</label>
                <InputNumber class="form-control" @bind-Value="club.AnioFundacion" />
                <ValidationMessage For="@(() => club.AnioFundacion)"></ValidationMessage>
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label">Ciudad</label>
            <InputText class="form-control" @bind-Value="club.Ciudad" />
            <ValidationMessage For="@(() => club.Ciudad)"></ValidationMessage>
        </div>
        <div class="mb-3">
            <label class="form-label">Descripción</label>
            <InputText class="form-control" @bind-Value="club.Descripcion" />
            <ValidationMessage For="@(() => club.Descripcion)"></ValidationMessage>
        </div>
    };

    // Títulos de las columnas de la tabla.
    public IEnumerable<string> Cab { get; set; } = ["ID", "Nombre", "Sigla", "Ciudad", "Fundación", "Descripción"];

    // Filtros actuales y la página que devolvió la API.
    private ClubFiltro filtro = new();
    private PagedResult<ClubDto>? resultado;

    // El select de orden guarda "columna|descendente".
    private string Orden
    {
        get => $"{filtro.OrdenarPor ?? "nombre"}|{(filtro.EsDescendente ? "true" : "false")}";
        set
        {
            var partes = value.Split('|');
            filtro.OrdenarPor = partes[0];
            filtro.Descendente = partes[1] == "true";
        }
    }

    // Flags de selección y de qué modal está abierto.
    public bool IsClubSelected { get; set; } = false;
    public bool ShowModalEdicion { get; set; } = false;
    public bool ShowModalCreacion { get; set; } = false;

    // Id del club seleccionado.
    public int IdClub { get; set; }

    // Objetos que se editan en los modales de edición y creación.
    public ClubUpdateRequest? clubEditando { get; set; }
    public ClubRequest? nuevoClub { get; set; }

    // Al abrir la página: controla permisos (base) y carga la primera página.
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await CargarClubesAsync();
    }

    // Marca la fila clickeada como seleccionada.
    private void SelectFila(ClubDto clubSelected)
    {
        this.IdClub = clubSelected.ClubId;
        IsClubSelected = true;
    }

    // Pide a la API la página actual con los filtros actuales.
    public async Task CargarClubesAsync()
    {
        await this.SecureExec(async () =>
        {
            this.resultado = await clubClient.GetPaginadoAsync(filtro);
            // Si la API ajustó la página (por ejemplo, se borró el último de la última página), se sincroniza.
            filtro.Pagina = resultado.Pagina;
            IsClubSelected = false;
        });
    }

    // Buscar con filtros nuevos siempre arranca en la página 1.
    private async Task BuscarAsync()
    {
        filtro.Pagina = 1;
        await CargarClubesAsync();
    }

    private async Task LimpiarFiltrosAsync()
    {
        filtro = new ClubFiltro { TamanoPagina = filtro.TamanoPagina };
        await CargarClubesAsync();
    }

    private async Task IrAPaginaAsync(int pagina)
    {
        filtro.Pagina = pagina;
        await CargarClubesAsync();
    }

    private async Task CambiarTamanoAsync(int tamano)
    {
        filtro.TamanoPagina = tamano;
        filtro.Pagina = 1;
        await CargarClubesAsync();
    }

    // Copia los datos del club seleccionado a un ClubUpdateRequest y abre el modal de edición.
    public void AbrirModalEdicion()
    {
        var clubOriginal = resultado?.Items.FirstOrDefault(c => c.ClubId == this.IdClub);
        if (clubOriginal is null) return;

        clubEditando = new ClubUpdateRequest
        {
            IdClub = clubOriginal.ClubId,
            Descripcion = clubOriginal.Descripcion ?? string.Empty,
            Abreviatura = clubOriginal.Abreviatura,
            Nombre = clubOriginal.Nombre,
            Ciudad = clubOriginal.Ciudad,
            AnioFundacion = clubOriginal.AnioFundacion
        };
        this.ShowModalEdicion = true;
    }

    // Cierra el modal de edición.
    public void CerrarModalEdicion()
    {
        this.ShowModalEdicion = false;
        MensajeError = null;
    }
    // Cierra el modal de creación.
    public void CerrarModalCreacion()
    {
        this.ShowModalCreacion = false;
        MensajeError = null;
    }

    // Abre el modal de creación con un club vacío.
    public void AbrirModalCreacion()
    {
        this.nuevoClub = new();
        this.ShowModalCreacion = true;
    }

    // Envía el club nuevo a la API; si salió bien cierra el modal y recarga la lista.
    public async Task EnviarNuevoClub()
    {
        if (nuevoClub is null) return;
        await this.SecureExec(async () =>
        {
            await this.clubClient.CreateAsync(nuevoClub);
        });

        if (MensajeError is not null) return;
        this.CerrarModalCreacion();
        await this.CargarClubesAsync();
    }

    // Envía el club editado a la API; si salió bien cierra el modal y recarga la lista.
    public async Task EnviarEditado()
    {
        if (clubEditando is null) return;
        await this.SecureExec(async () =>
        {
            await clubClient.UpdateAsync(clubEditando);
        });

        if (MensajeError is not null) return;
        CerrarModalEdicion();
        await this.CargarClubesAsync();
    }

    // Borra el club seleccionado y recarga la lista.
    public async Task EliminarClub()
    {
        await this.SecureExec(async () => await clubClient.DeleteAsync(this.IdClub));
        if (MensajeError is not null) return;
        await this.CargarClubesAsync();
    }
}
