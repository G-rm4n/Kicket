@page "/Admin/Clubs"
@using Kicket.Contracts.Clubes
@using Kicket.ApiClient.Abstracciones
@inherits PaginaProtegida
@layout AdminLayout
@inject IClubApiClient clubClient

<div class="d-flex flex-column mb-3 h-100" @onclick="() => { IsClubSelected = false; this.IdClub = -7; }">
    <h1>
        Gestionar Clubes
    </h1>
        <div @onclick:stopPropagation="true" class="p-3">
            <GenericTable TItem="ClubDto" DatosTabla="clubs ?? Enumerable.Empty<ClubDto>()"
                          OnClick="SelectFila"
                          FilaSeleccionada="@(c=>c.ClubId==this.IdClub)">
                <Cabeceras>
                    @foreach(var value in Cab)
                    {
                        <th>@value</th>
                    }
                </Cabeceras>
                <fila Context="Club">
                    <td>@Club.ClubId</td>
                    <td>@Club.Nombre</td>
                    <td>@Club.Descripcion</td>
                    <td>@Club.Abreviatura</td>
                </fila>
            </GenericTable>
        </div>

            <div class="d-flex justify-content-end flex-row gap-4 w-100">
                <button class="btn btn-danger text-white" disabled="@(!IsClubSelected)" @onclick="EliminarClub">Borrar Club</button>
                <button class="btn bg-primary text-white" disabled="@(!IsClubSelected)" @onclick="AbrirModalEdicion">Editar Club</button>
                <button class="btn btn-green" @onclick="AbrirModalCreacion">Crear Club</button>
                <button class="btn bg-secondary text-white" @onclick="CargarClubesAsync">Refrescar</button>
            </div>
    @if (this.ShowModalEdicion && clubEditando is not null)
    {
        <GenericModalForm TOjb="ClubUpdateRequest" Obj="clubEditando" Titulo="Editar Club" OnCerrar="CerrarModalEdicion" Onsubmit="EnviarEditado">

            <CuerpoForm Context="club">
                <div class="mb-3">
                    <label class="form-label">Nombre</label>
                    <InputText class="form-control" @bind-Value="club!.Nombre" />
                    <ValidationMessage For="@(()=>club.Nombre)"></ValidationMessage>
                </div>
                <div class="mb-3">
                    <label class="form-label">Abreviatura</label>
                    <InputText class="form-control" @bind-Value="club.Abreviatura" />
                    <ValidationMessage For="@(() => club.Abreviatura)"></ValidationMessage>
                </div>
                <div class="mb-3">
                    <label class="form-label">Descripción</label>
                    <InputText class="form-control" @bind-Value="club.Descripcion" />
                    <ValidationMessage For="@(() => club.Descripcion)"></ValidationMessage>
                </div>
            </CuerpoForm>

        </GenericModalForm>
    }

    @if (this.ShowModalCreacion && nuevoClub is not null)
    {
        <GenericModalForm TOjb="ClubRequest" Obj="nuevoClub" Titulo="Crear Club" OnCerrar="CerrarModalCreacion" Onsubmit="EnviarNuevoClub">

            <CuerpoForm Context="club">
                <div class="mb-3">
                    <label class="form-label">Nombre</label>
                    <InputText class="form-control" @bind-Value="club!.Nombre" />
                    <ValidationMessage For="@(() => club.Nombre)"></ValidationMessage>
                </div>
                <div class="mb-3">
                    <label class="form-label">Abreviatura</label>
                    <InputText class="form-control" @bind-Value="club.Abreviatura" />
                    <ValidationMessage For="@(() => club.Abreviatura)"></ValidationMessage>
                </div>
                <div class="mb-3">
                    <label class="form-label">Descripción</label>
                    <InputText class="form-control" @bind-Value="club.Descripcion" />
                    <ValidationMessage For="@(() => club.Descripcion)"></ValidationMessage>
                </div>
            </CuerpoForm>

        </GenericModalForm>
    }

    @if (!string.IsNullOrEmpty(MensajeError))
    {
        <div class="alert alert-danger mt-3">
            @MensajeError
        </div>
    }
</div>

@code {
    public IEnumerable<string> Cab { get; set; } = ["ID", "Nombre", "Descripción", "Abreviatura"];

    public IEnumerable<ClubDto>? clubs { get; set; }

    public bool IsClubSelected { get; set; } = false;
    public bool ShowModalEdicion { get; set; } = false;
    public bool ShowModalConfirmacion { get; set; } = false;
    public bool ShowModalCreacion { get; set; } = false;

    public int IdClub { get; set; }

    public ClubUpdateRequest? clubEditando { get; set; }
    public ClubRequest? nuevoClub { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await CargarClubesAsync();
    }

    private void SelectFila(ClubDto clubSelected)
    {
        this.IdClub = clubSelected.ClubId;
        IsClubSelected = true;
    }

    public async Task CargarClubesAsync()
    {
        await this.SecureExec(async () =>
        {
            this.clubs = await clubClient.GetAllAsync();
        });
    }

    public void AbrirModalEdicion()
    {
        if (clubs is null) return;
        var clubOriginal = clubs.FirstOrDefault(c => c.ClubId == this.IdClub);
        if (clubOriginal is null) return;

        clubEditando = new ClubUpdateRequest
        {
            IdClub = clubOriginal.ClubId,
            Descripcion = clubOriginal.Descripcion ?? string.Empty,
            Abreviatura = clubOriginal.Abreviatura,
            Nombre = clubOriginal.Nombre
        };
        this.ShowModalEdicion = true;
    }

    public void CerrarModalEdicion()
    {
        this.ShowModalEdicion = false;
    }
    public void CerrarModalCreacion()
    {
        this.ShowModalCreacion = false;
    }

    public void AbrirModalCreacion()
    {
        this.nuevoClub = new();
        this.ShowModalCreacion = true;
    }

    public async Task EnviarNuevoClub()
    {
        if (nuevoClub is null) return;
        await this.SecureExec(async () =>
        {
            await this.clubClient.CreateAsync(nuevoClub);
        });

        this.CerrarModalCreacion();
        await this.CargarClubesAsync();
    }

    public async Task EnviarEditado()
    {
        if (clubEditando is null) return;
        await this.SecureExec(async () =>
        {
            await clubClient.UpdateAsync(clubEditando);
        });

        CerrarModalEdicion();
        await this.CargarClubesAsync();
    }

    public async Task EliminarClub()
    {
        await this.SecureExec(async () => await clubClient.DeleteAsync(this.IdClub));
        await this.CargarClubesAsync();
    }
}
