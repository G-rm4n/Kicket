@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@using Kicket.Contracts.Auth
<EditForm Model="@loginData"  OnValidSubmit="EnviarDatos" FormName="LoginForm">
    <DataAnnotationsValidator/>
    <ValidationSummary/>
   <div class="mb-3">
       <label class="form-label" for="Email">Email</label>
       <InputText class="form-control" id="Email" @bind-Value="loginData.Email"></InputText>
   </div>
   <div class="mb-3">
        <label class="form-label" for="Pass">Contraseña</label>
        <InputText type="password" class="form-control" id="Pass" @bind-Value="loginData.Pass"></InputText>
   </div>
   <div class="mb-3">
       <button type="submit" class="btn btn-primary">Iniciar</button>
   </div>
</EditForm>

@code {
    [Parameter]
    public EventCallback<LoginRequest> submit{ get; set; }
    [SupplyParameterFromForm]
    private LoginRequest loginData { get; set; } = new();

    public async Task EnviarDatos()
    {
        await submit.InvokeAsync(loginData);
    }
}
