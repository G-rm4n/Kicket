@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@using Kicket.Contracts.Auth


<div class="kicket-form-container">
<EditForm Model="@loginData" OnValidSubmit="EnviarDatos" FormName="LoginForm">
    <DataAnnotationsValidator />

    
    <div class="mb-4">
        <div class="input-icon-wrapper">
            <svg class="icon-left" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>

            <InputText id="Email" class="form-control kicket-input pl-icon" placeholder="Correo electrónico" @bind-Value="loginData.Email" />
        </div>
        <ValidationMessage For="@(() => loginData.Email)" class="text-danger small mt-1 d-block" />
    </div>

    
    <div class="mb-3">
        <div class="input-icon-wrapper">
            <svg class="icon-left" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>

            <InputText type="password" id="Pass" class="form-control kicket-input pl-icon pr-icon" placeholder="Ingresar contraseña" @bind-Value="loginData.Pass" />

            
            <svg class="icon-right" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"></path></svg>
        </div>
        <ValidationMessage For="@(() => loginData.Pass)" class="text-danger small mt-1 d-block" />
    </div>

    <!-- Botón -->
    <div class="d-grid">
        <button type="submit" class="btn btn-green rounded-1">Iniciar sesión</button>
    </div>
</EditForm>
</div>

@code {
    [Parameter]
    public EventCallback<LoginRequest> submit { get; set; }

    [SupplyParameterFromForm]
    private LoginRequest loginData { get; set; } = new();

    public async Task EnviarDatos()
    {
        await submit.InvokeAsync(loginData);
    }
}
