@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@using Kicket.Contracts.Usuarios


<div class="kicket-form-container">
    <EditForm Model="@RegistroData" OnValidSubmit="@EnviarDatos" FormName="RegisterForm">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <div class="input-icon-wrapper">
                <!-- Ícono de usuario genérico -->
                <svg class="icon-left" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>

                <InputText id="Nombre" class="form-control kicket-input pl-icon" placeholder="Nombre" @bind-Value="RegistroData.Nombre" />
            </div>
            <ValidationMessage For="@(() => RegistroData.Nombre)" class="text-danger small mt-1 d-block" />
        </div>

        <!-- Apellido -->
        <div class="mb-3">
            <div class="input-icon-wrapper">
                <!-- Ícono de usuario genérico -->
                <svg class="icon-left" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>

                <InputText id="Apellido" class="form-control kicket-input pl-icon" placeholder="Apellido" @bind-Value="RegistroData.Apellido" />
            </div>
            <ValidationMessage For="@(() => RegistroData.Apellido)" class="text-danger small mt-1 d-block" />
        </div>

        <!-- Email -->
        <div class="mb-3">
            <div class="input-icon-wrapper">
                <svg class="icon-left" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>

                <InputText id="Email" class="form-control kicket-input pl-icon" placeholder="Correo electrónico" @bind-Value="RegistroData.Email" />
            </div>
            <ValidationMessage For="@(() => RegistroData.Email)" class="text-danger small mt-1 d-block" />
        </div>

        <!-- Contraseña -->
        <div class="mb-4">
            <div class="input-icon-wrapper">
                <svg class="icon-left" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                </svg>

                <InputText type=@(IsPasswordRevealed?"text":"password") id="Pass" class="form-control kicket-input pl-icon pr-icon" placeholder="Ingresar contraseña" @bind-Value="RegistroData.Pass" />

                <svg class="icon-right" fill="none" stroke="currentColor" viewBox="0 0 24 24" @onclick="@(()=> IsPasswordRevealed=!IsPasswordRevealed)">
                    @if (!IsPasswordRevealed)
                    {
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"></path>
                    } else
                    {
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                    }
                </svg>
            </div>
            <ValidationMessage For="@(() => RegistroData.Pass)" class="text-danger small mt-1 d-block" />
        </div>

        <!-- Botón -->
        <div class="d-grid">
            <button type="submit" class="btn btn-green rounded-1">Registrarse</button>
        </div>
    </EditForm>
</div>
@code {
    private bool IsPasswordRevealed { get; set; } = false;
    [Parameter]
    public EventCallback<UsuarioRequest> submit { get; set; }
    [SupplyParameterFromForm]
    private UsuarioRequest RegistroData { get; set; } = new(){Rol="Cliente"};

    public async Task EnviarDatos()
    {
        await submit.InvokeAsync(RegistroData);
    }
}
