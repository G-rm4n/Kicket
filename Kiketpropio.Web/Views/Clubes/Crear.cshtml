@model Club
@{
    ViewData["Title"] = "Nuevo club";
}

<div class="panel">
    <h1>Nuevo club</h1>

    @if (ViewBag.Error != null)
    {
        <div class="error">@ViewBag.Error</div>
    }

    <form asp-action="Crear" method="post">
        <div class="campo">
            <label asp-for="Nombre">Nombre</label>
            <input asp-for="Nombre" />
        </div>
        <div class="campo">
            <label asp-for="Logo_Url">URL del logo</label>
            <input asp-for="Logo_Url" />
        </div>
        <div class="acciones">
            <button type="submit" class="boton verde">Guardar</button>
            <a class="boton gris" asp-action="Index">Cancelar</a>
        </div>
    </form>
</div>
